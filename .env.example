# Copy this file to a new file named ".env" in the same folder (the project
# root, next to package.json) and fill in your own values.
#
# Where to find these values: Supabase dashboard -> your project ->
# Settings -> API.
#   VITE_SUPABASE_URL      = the "Project URL"
#   VITE_SUPABASE_ANON_KEY = the "anon public" key (NOT the "service_role" key)
#
# Never put the service_role key in this file or anywhere in the frontend
# code — it bypasses Row Level Security and must only ever be used on a
# trusted server, never in a browser app like this one.
#
# The VITE_ prefix is required — Vite only exposes env variables that start
# with VITE_ to the browser code (see src/lib/supabaseClient.js).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
